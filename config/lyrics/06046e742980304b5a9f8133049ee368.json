{
  "title": "身骑白马",
  "artist": "徐佳莹",
  "updatedAt": 1794730656260,
  "doc": [
    {
      "start": 37300,
      "text": "我爱谁 跨不过 从来也不觉得错",
      "tokens": [],
      "credit": false
    },
    {
      "start": 44570,
      "text": "自以为 抓着痛 就能往回忆里躲",
      "tokens": [],
      "credit": false
    },
    {
      "start": 51480,
      "text": "偏执相信着 受诅咒的水晶球",
      "tokens": [],
      "credit": false
    },
    {
      "start": 58880,
      "text": "阻挡可能心动的理由",
      "tokens": [],
      "credit": false
    },
    {
      "start": 66790,
      "text": "而你却 靠近了 逼我们视线交错",
      "tokens": [],
      "credit": false
    },
    {
      "start": 73730,
      "text": "原地不动 或向前走",
      "tokens": [],
      "credit": false
    },
    {
      "start": 77750,
      "text": "突然在意这分钟",
      "tokens": [],
      "credit": false
    },
    {
      "start": 81170,
      "text": "眼前荒沙弥漫了等候",
      "tokens": [],
      "credit": false
    },
    {
      "start": 84650,
      "text": "耳边传来孱弱的呼救",
      "tokens": [],
      "credit": false
    },
    {
      "start": 88220,
      "text": "追赶要我爱得不保留",
      "tokens": [],
      "credit": false
    },
    {
      "start": 97930,
      "text": "我身骑白马 走三关",
      "tokens": [],
      "credit": false
    },
    {
      "start": 105310,
      "text": "我改换素衣 回中原",
      "tokens": [],
      "credit": false
    },
    {
      "start": 112740,
      "text": "放下西凉 没人管",
      "tokens": [],
      "credit": false
    },
    {
      "start": 120050,
      "text": "我一心只想 王宝钏",
      "tokens": [],
      "credit": false
    },
