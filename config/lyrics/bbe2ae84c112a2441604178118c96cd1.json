    },
    {
      "start": 228810,
      "text": "先生与我 有何不同",
      "tokens": [],
      "credit": false
    },
    {
      "start": 237540,
      "text": "我是我 最大的 野心啊",
      "tokens": [],
      "credit": false
    },
    {
      "start": 243420,
      "text": "踏黄沙闯霓虹 深渊赶路也无恐",
      "tokens": [],
      "credit": false
    },
    {
      "start": 251970,
      "text": "我是我 最爱的 野心家",
      "tokens": [],
      "credit": false
    },
    {
      "start": 257820,
      "text": "若世界容不下 去撞破它成为我",
      "tokens": [],
      "credit": false
    },
    {
      "start": 261030,
      "text": "去驯服它 平视我",
      "tokens": [],
      "credit": false
    },
    {
      "start": 262650,
      "text": "去告诉它 何为我",
      "tokens": [],
      "credit": false
