    },
    {
      "start": 193770,
      "text": "这世界容不下 那就刺破它吧",
      "tokens": [],
      "credit": false
    },
    {
      "start": 197580,
      "text": "我的苦修 我的疼痛",
      "tokens": [],
      "credit": false
    },
    {
      "start": 201180,
      "text": "终将转身 赞颂我",
      "tokens": [],
