{
  "title": "天若有情",
  "artist": "A-Lin",
  "updatedAt": 1794730653679,
  "doc": [
    {
      "start": 15360,
      "text": "风扬起时繁花落尽",
      "tokens": [],
      "credit": false
    },
    {
      "start": 20700,
      "text": "谁执笔为你绘丹青",
      "tokens": [],
      "credit": false
    },
    {
      "start": 26580,
      "text": "月下独影泪湿青衣",
      "tokens": [],
      "credit": false
    },
    {
      "start": 32220,
      "text": "流水不付一世深情",
      "tokens": [],
      "credit": false
    },
    {
      "start": 37920,
      "text": "只身回望太匆匆",
      "tokens": [],
      "credit": false
    },
    {
      "start": 40920,
      "text": "此生多少情与仇",
      "tokens": [],
      "credit": false
    },
    {
      "start": 44430,
      "text": "只愿与你长相守",
      "tokens": [],
      "credit": false
    },
    {
      "start": 49410,
      "text": "无边丝雨细如愁",
      "tokens": [],
      "credit": false
    },
    {
      "start": 52350,
      "text": "朝来寒雨几回眸",
      "tokens": [],
      "credit": false
    },
    {
      "start": 55890,
      "text": "你在哪一方停留",
      "tokens": [],
      "credit": false
    },
    {
      "start": 60930,
      "text": "天若有情亦无情",
      "tokens": [],
      "credit": false
    },
    {
      "start": 66240,
      "text": "爱到最后要分离",
      "tokens": [],
      "credit": false
    },
    {
      "start": 72120,
      "text": "你轮回的印记",
      "tokens": [],
      "credit": false
    },
    {
      "start": 75120,
      "text": "落在我眉宇",
      "tokens": [],
      "credit": false
    },
    {
      "start": 77940,
      "text": "直到有一天不能呼吸",
      "tokens": [],
      "credit": false
    },
