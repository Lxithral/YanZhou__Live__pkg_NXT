{
  "title": "天上掉下个林妹妹",
  "artist": "黄诗扶",
  "updatedAt": 1794730654046,
  "doc": [
    {
      "start": 15650,
      "text": "过眼云烟聚了散了心神不定",
      "tokens": [],
      "credit": false
    },
    {
      "start": 19250,
      "text": "有人偏偏恸呀疯呀冥顽不灵",
      "tokens": [],
      "credit": false
    },
    {
      "start": 23060,
      "text": "离恨天上这般没情没趣",
      "tokens": [],
      "credit": false
    },
    {
      "start": 26790,
      "text": "披个因缘就闯人间相思地",
      "tokens": [],
      "credit": false
    },
    {
      "start": 30860,
      "text": "他是难捱离了别了一干二净",
      "tokens": [],
      "credit": false
    },
    {
      "start": 34340,
      "text": "我是难免嗔呀恼呀眼泪还清",
      "tokens": [],
      "credit": false
    },
    {
      "start": 38340,
      "text": "倾国倾城 对着多愁多病",
      "tokens": [],
      "credit": false
    },
    {
      "start": 42230,
      "text": "难怪相看竟是个难得知己",
      "tokens": [],
      "credit": false
    },
    {
      "start": 47180,
      "text": "天上掉下个林妹妹，似轻云出岫",
      "tokens": [],
      "credit": false
    },
    {
      "start": 51240,
      "text": "娴静如花照水，行动好比风扶柳",
      "tokens": [],
      "credit": false
    },
    {
      "start": 54970,
      "text": "只道他草莽人轻浮，原来非俗流",
      "tokens": [],
      "credit": false
    },
    {
      "start": 58890,
      "text": "眉梢藏秀气～",
      "tokens": [],
      "credit": false
    },
    {
      "start": 63180,
      "text": "天葩飞堕广寒宫，片片清香引碧空",
      "tokens": [],
      "credit": false
    },
    {
      "start": 69720,
      "text": "仿佛众仙吹歇月朦胧",
      "tokens": [],
      "credit": false
    },
    {
      "start": 77680,
      "text": "花飞便觉春容减，一阵狂风满地红",
      "tokens": [],
      "credit": false
    },
    {
      "start": 85050,
      "text": "人间还剩几回同",
      "tokens": [],
      "credit": false
    },
    {
      "start": 95790,
      "text": "天上掉下个林妹妹～",
      "tokens": [],
      "credit": false
    },
    {
      "start": 99310,
      "text": "似一朵轻云刚出岫～",
      "tokens": [],
      "credit": false
    },
    {
      "start": 123140,
      "text": "盟是从前许了应了风月旧题",
      "tokens": [],
      "credit": false
    },
    {
      "start": 126830,
      "text": "别是如今怨呀恨呀风流云去",
      "tokens": [],
      "credit": false
    },
    {
      "start": 130480,
      "text": "心肠性命 哪个由得自己",
      "tokens": [],
      "credit": false
    },
    {
      "start": 134220,
      "text": "只盼能怜我怜卿",
      "tokens": [],
      "credit": false
    },
    {
      "start": 139240,
      "text": "天上掉下个林妹妹，似轻云出岫",
      "tokens": [],
      "credit": false
    },
    {
      "start": 143450,
      "text": "娴静如花照水，行动好比风扶柳",
      "tokens": [],
      "credit": false
    },
    {
      "start": 147180,
      "text": "只道他草莽人轻浮，原来非俗流",
      "tokens": [],
      "credit": false
    },
    {
      "start": 151110,
      "text": "眉梢藏秀气～",
      "tokens": [],
      "credit": false
    },
    {
      "start": 154810,
      "text": "（眼前分明外来客）",
      "tokens": [],
      "credit": false
    },
    {
      "start": 155950,
      "text": "滴不完相思血泪呀，血泪抛红豆",
      "tokens": [],
      "credit": false
    },
    {
      "start": 158410,
      "text": "开不完春柳呀，春柳春花满楼",
      "tokens": [],
      "credit": false
    },
    {
      "start": 161610,
      "text": "（心底却似旧时友）",
      "tokens": [],
      "credit": false
    },
    {
      "start": 162000,
      "text": "照不见镜里形容瘦，展不开眉头",
      "tokens": [],
      "credit": false
    },
    {
      "start": 166310,
      "text": "挨不明更漏",
      "tokens": [],
      "credit": false
    },
    {
      "start": 170020,
      "text": "天葩飞堕广寒宫，片片清香引碧空",
      "tokens": [],
      "credit": false
    },
    {
      "start": 177130,
      "text": "仿佛众仙吹歇月朦胧",
      "tokens": [],
      "credit": false
    },
    {
      "start": 184510,
      "text": "花飞便觉春容减，一阵狂风满地红",
      "tokens": [],
      "credit": false
    },
    {
      "start": 192690,
      "text": "人间还剩几回同",
      "tokens": [],
      "credit": false
    },
    {
      "start": 199920,
      "text": "鸿蒙辟后谁干净 你偿荒唐我偿情",
      "tokens": [],
      "credit": false
    },
    {
      "start": 208120,
      "text": "哪个不是忡忡一身病",
      "tokens": [],
      "credit": false
    },
    {
      "start": 215940,
      "text": "愁根别种红尘墟，魂魄追去鸳鸯侣",
      "tokens": [],
      "credit": false
    },
    {
      "start": 223230,
      "text": "相思簿上销姓名",
      "tokens": [],
      "credit": false
    }
  ]
}
