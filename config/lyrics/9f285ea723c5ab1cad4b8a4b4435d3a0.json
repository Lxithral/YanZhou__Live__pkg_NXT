  "doc": [
    {
      "start": 8200,
      "text": "The window is open, so’s that door",
      "tokens": [],
      "credit": false,
      "translation": "所有的门和窗打开了"
    },
    {
      "start": 10460,
      "text": "I didn’t know they did that anymore",
